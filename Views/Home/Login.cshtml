@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title>Login - INFASS</title>
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css?family=Lato:400,700,400italic,700italic" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" />
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: "Lato", sans-serif;
            min-height: 100vh;
            background: linear-gradient(135deg, #2c3e50 0%, #1a252f 100%);
            display: flex;
            flex-direction: column;
        }
        .auth-nav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 1000;
            background: #2c3e50;
            border-bottom: 1px solid rgba(26,188,156,0.3);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0.9rem 2rem;
            font-family: "Montserrat", sans-serif; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.06em;
        }
        .auth-nav a { color: #fff; text-decoration: none; }
        .auth-nav a:hover { color: #1abc9c; }
        .auth-nav .back { font-size: 0.78rem; color: rgba(255,255,255,0.65); }
        .auth-wrapper {
            flex: 1; display: flex; align-items: center; justify-content: center;
            padding: 6rem 1rem 3rem;
        }
        .auth-card {
            width: 100%; max-width: 420px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 1rem; padding: 2.5rem 2.2rem 2rem;
            box-shadow: 0 20px 60px rgba(0,0,0,0.45);
        }
        .auth-title {
            font-family: "Montserrat", sans-serif; font-weight: 700;
            font-size: 1.8rem; text-transform: uppercase;
            color: #fff; text-align: center; margin-bottom: 0.3rem;
        }
        .auth-sub { text-align: center; color: rgba(255,255,255,0.5); font-size: 0.88rem; margin-bottom: 1.5rem; }
        .divider { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 1.8rem; }
        .divider-line { flex: 1; height: 2px; background: #1abc9c; }
        .divider-icon { color: #1abc9c; font-size: 0.9rem; }
        .form-group { margin-bottom: 1.2rem; }
        .form-label {
            display: block; color: rgba(255,255,255,0.7); font-size: 0.75rem;
            font-family: "Montserrat", sans-serif; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.09em; margin-bottom: 0.4rem;
        }
        .form-ctrl {
            width: 100%; padding: 0.72rem 1rem;
            background: rgba(255,255,255,0.07); border: 1.5px solid rgba(255,255,255,0.14);
            border-radius: 0.5rem; color: #fff; font-size: 0.93rem;
            font-family: "Lato", sans-serif; outline: none;
            transition: border-color 0.25s, box-shadow 0.25s;
        }
        .form-ctrl::placeholder { color: rgba(255,255,255,0.28); }
        .form-ctrl:focus { border-color: #1abc9c; box-shadow: 0 0 0 3px rgba(26,188,156,0.18); }
        .btn-auth {
            display: block; width: 100%; padding: 0.85rem; margin-top: 0.5rem;
            background: #1abc9c; color: #fff; border: 2px solid #1abc9c;
            border-radius: 0.4rem; font-family: "Montserrat", sans-serif;
            font-weight: 700; font-size: 0.88rem; text-transform: uppercase;
            letter-spacing: 0.1em; cursor: pointer;
            transition: background 0.25s, color 0.25s;
        }
        .btn-auth:hover { background: transparent; color: #1abc9c; }
        .auth-foot {
            text-align: center; color: rgba(255,255,255,0.45);
            font-size: 0.87rem; margin-top: 1.4rem;
        }
        .auth-foot a { color: #1abc9c; text-decoration: none; font-weight: 700; }
        .auth-foot a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <nav class="auth-nav">
        <a href="/" style="font-size:1.3rem;">INFASS</a>
        <a class="back" href="/"><i class="fas fa-arrow-left"></i> Back to Home</a>
    </nav>

    <div class="auth-wrapper">
        <div class="auth-card">
            <h1 class="auth-title">Sign In</h1>
            <p class="auth-sub">Login to your account</p>
            <div class="divider">
                <div class="divider-line"></div>
                <div class="divider-icon"><i class="fas fa-star"></i></div>
                <div class="divider-line"></div>
            </div>

            <div class="form-group">
                <label class="form-label">Username</label>
                <input class="form-ctrl" type="text" id="loginUsername" placeholder="Enter username" />
            </div>
            <div class="form-group">
                <label class="form-label">Password</label>
                <input class="form-ctrl" type="password" id="loginPassword" placeholder="Enter password" />
            </div>

            <button type="button" class="btn-auth" id="btnLogin">
                <i class="fas fa-sign-in-alt"></i> Login
            </button>

            <p class="auth-foot">
                Don't have an account? <a href="/Home/Register">Register Here</a>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>
